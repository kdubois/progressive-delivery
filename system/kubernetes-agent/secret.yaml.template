apiVersion: v1
kind: Secret
metadata:
  name: kubernetes-agent
  namespace: openshift-gitops
type: Opaque
stringData:
  # Analysis model API key
  analysis_api_key: ${ANALYSIS_API_KEY}

  # Optional: decision-model key for the second opinion.
  # The grader disables itself when this is empty.
  typesafe_api_key: ${TYPESAFE_API_KEY:}

  # Optional: second-opinion key for the analysis escalation (enmaas).
  # The escalation tier disables itself when this is empty.
  analysis_second_opinion_api_key: ${ANALYSIS_SECOND_OPINION_API_KEY:}
